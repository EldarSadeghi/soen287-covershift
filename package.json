{
  "name": "covershift",
  "version": "0.1.0",
  "private": true,
  "description": "Small-business shift coverage with manager approval",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "check": "node --check src/server.js"
  }
}
