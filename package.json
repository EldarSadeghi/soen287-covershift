{
  "name": "covershift",
  "version": "0.1.0",
  "private": true,
  "description": "Small-business shift coverage with manager approval",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "data:seed": "node --env-file-if-exists=.env scripts/data.js seed",
    "data:inspect": "node --env-file-if-exists=.env scripts/data.js inspect"
  }
}
