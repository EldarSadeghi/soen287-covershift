# Local development only. Copy this file to .env to override defaults.
HOST=127.0.0.1
PORT=3000
# Optional absolute or project-relative directory for private JSON storage.
DATA_DIRECTORY=./data
# For HTTPS deployment: exact public origin, no trailing slash.
# PUBLIC_ORIGIN=https://covershift.example
# Optional local demo utility reads DEMO_PASSWORD from your private environment.
# Do not enable or deploy fictional demo accounts in production.
# Optional CS-031A AI drafting. Manual scheduling works without a key.
# Keep your real key only in the ignored .env file; never in public/ or Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Server-enforced limits: 500 lifetime requests per DATA_DIRECTORY, 20 per
# manager per UTC day, 5 attempts per 10 minutes, no automatic paid retries.
# Set a separate provider hard spend limit and disable auto-reload in Billing.
